<Window
    x:Class="Angles.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Mica 需 WinAppSDK 1.6+ 的普通桌面窗口；backdrop 由 code-behind SystemBackdrop 设定 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标识条：lucide 图标 + 品牌名 -->
        <Grid Grid.Row="0" Padding="28,26,28,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="LogoIcon" Width="26" Height="26" Stretch="Fill" />
                <TextBlock Text="Angles" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="desktop preview" FontSize="11"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 主体面板 -->
        <Grid Grid.Row="1" Padding="28,18,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="16" Padding="28" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="你的编码 agent，长在桌面上了。"
                               FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Angles core 仍是那个 2MB 的 Rust 引擎；Graph、对话与文件操作正用 WinUI 3 接成形。"
                               FontSize="14" Opacity="0.75"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,24,0,0">
                        <Button x:Name="StartBtn" Style="{StaticResource AccentButtonStyle}"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image x:Name="StartIcon" Width="16" Height="16" />
                                <TextBlock Text="启动 Angles core" />
                            </StackPanel>
                        </Button>
                        <Button>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image x:Name="SettingsIcon" Width="16" Height="16" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="12" Opacity="0.6"
                       Margin="0,14,0,0" />
        </Grid>
    </Grid>
</Window>
