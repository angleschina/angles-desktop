<Application
    x:Class="Angles.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Angles.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 主题色：Angles 荧光青绿，贴合 terminal 美学 -->
            <Color x:Key="AccentLightColor">#FF2DD4BF</Color>
            <Color x:Key="AccentDarkColor">#FF2DD4BF</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
